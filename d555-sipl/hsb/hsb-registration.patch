Register the d555-sipl Holoscan code with HSB 2.7.0 (applied by tools/prepare_hsb.sh d555 after it
copies d555-sipl/hsb/{src,python,examples} into the tree): the d555_sipl_capture operator in the
SIPL block, the image_decoder operator and its Python binding, ImageDecoderOp in the operator
registry, the d555 sensor module, and the d555_sipl_player example.

diff --git a/examples/CMakeLists.txt b/examples/CMakeLists.txt
index 6ebece5..8c501b5 100644
--- a/examples/CMakeLists.txt
+++ b/examples/CMakeLists.txt
@@ -605,6 +605,23 @@ if(HOLOLINK_BUILD_SIPL)
   )
 
   list(APPEND EXAMPLE_INSTALL_TARGETS sipl_player)
+
+  add_executable(d555_sipl_player
+    d555_sipl_player.cpp
+  )
+
+  target_link_libraries(d555_sipl_player
+    PRIVATE
+      hololink
+      hololink::operators::image_processor
+      hololink::operators::packed_format_converter
+      hololink::operators::d555_sipl_capture
+      holoscan::core
+      holoscan::ops::bayer_demosaic
+      holoscan::ops::holoviz
+  )
+
+  list(APPEND EXAMPLE_INSTALL_TARGETS d555_sipl_player)
 endif() # HOLOLINK_BUILD_SIPL
 
 if(HOLOLINK_BUILD_SOCKET)
