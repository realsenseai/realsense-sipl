     }
@@ -394,6 +397,9 @@ bool FusaCoeCaptureCore::alloc_sci_buf(NvSciBufObj& buf_obj, size_t& size)
         case hololink::csi::PixelFormat::RAW_12:
             color_format = NvSciColor_Bayer16RGGB;
             break;
